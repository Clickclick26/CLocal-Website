#!/bin/sh
# Blocks a commit that would put an internal/secret-looking file onto the
# live public site (clocal.co.uk is served straight from this repo -- see
# .gitignore for the 2026-09-13 incident this exists because of).
#
# One-time setup per clone (not automatic -- git doesn't run hooks from a
# tracked folder on its own):
#   git config core.hooksPath .githooks

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

blocked=0
pattern='(^|/)(supabase/paste/|.*\.sql$|.*access-code.*|.*password.*|clocal_theme\.dart$|CLAUDE_SESSION.*\.md$)'

echo "$staged" | grep -Eqi "$pattern" && {
  echo ""
  echo "BLOCKED: this commit stages a file that looks like an internal/secret"
  echo "reference file, not a real website file. This repo is PUBLIC and every"
  echo "tracked file becomes a live URL on clocal.co.uk the moment it's pushed."
  echo ""
  echo "Files matched:"
  echo "$staged" | grep -Ei "$pattern" | sed 's/^/  - /'
  echo ""
  echo "If this really belongs on the site, rename it so it doesn't match the"
  echo "pattern above. Otherwise keep it out of this repo entirely."
  blocked=1
}

[ "$blocked" = "1" ] && exit 1

# Prize and positioning copy. Two mistakes have each shipped more than once:
# wording that promises every member a voucher, and a fixed winner count when
# there are several vouchers. scripts/check-prize-copy.js has the detail.
copy_files=$(echo "$staged" | grep -Ei '\.(html|js|md|txt)$' | grep -v '^scripts/check-prize-copy\.js$')
if [ -n "$copy_files" ] && command -v node >/dev/null 2>&1; then
  # shellcheck disable=SC2086
  node scripts/check-prize-copy.js $copy_files || {
    echo "Blocked by scripts/check-prize-copy.js. Fix the copy, or add a"
    echo "deliberate exception in that file if the check is wrong."
    exit 1
  }
fi

exit 0
